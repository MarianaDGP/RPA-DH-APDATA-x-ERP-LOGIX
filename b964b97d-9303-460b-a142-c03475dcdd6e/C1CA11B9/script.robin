@@ConnectionString: ''
@@Type: 'Local'
@@DesktopType: 'local'
@@DisplayName: 'Computador local'
IMPORT 'controlRepo.appmask' AS appmask
IMPORT 'imageRepo.imgrepo' AS imgrepo
@SENSITIVE: []
Folder.GetFiles Folder: $'''\\\\10.10.0.203\\logix\\unl''' FileFilter: $'''*.dat''' IncludeSubfolders: False FailOnAccessDenied: True SortBy1: Folder.SortBy.NoSort SortDescending1: False SortBy2: Folder.SortBy.NoSort SortDescending2: False SortBy3: Folder.SortBy.NoSort SortDescending3: False Files=> Files
System.RunApplication.RunApplication ApplicationPath: $'''C:\\CRM\\V12\\ERP12.lnk''' WindowStyle: System.ProcessWindowStyle.Normal ProcessId=> AppProcessId
LOOP FOREACH CurrentItem IN Files
    WAIT (UIAutomation.WaitForImage.ToAppearOnScreen Images: [imgrepo['imgTelaInicial']] FindAllImages: False Tolerance: 10 SearchAlgorithm: UIAutomation.ImageFinderAlgorithm.Legacy X=> X2 Y=> Y2)
    Text.GetSubtext.GetSubtext Text: CurrentItem.Name CharacterPosition: 0 NumberOfChars: 1 Subtext=> Empresa1
    Text.GetSubtext.GetSubtext Text: CurrentItem.Name CharacterPosition: 1 NumberOfChars: 1 Subtext=> Empresa2
    WAIT 1
    MouseAndKeyboard.SendKeys.FocusAndSendKeys TextToSend: $'''{Control}({F5})''' DelayBetweenKeystrokes: 10 SendTextAsHardwareKeys: False
    WAIT (UIAutomation.WaitForImage.ToAppearOnScreen Images: [imgrepo['ImgSelecionaEmpresa']] FindAllImages: False Tolerance: 10 SearchAlgorithm: UIAutomation.ImageFinderAlgorithm.Legacy X=> X2 Y=> Y2)
    MouseAndKeyboard.SendKeys.FocusAndSendKeys TextToSend: $'''{Tab}''' DelayBetweenKeystrokes: 10 SendTextAsHardwareKeys: False
    WAIT 1
    MouseAndKeyboard.SendKeys.FocusAndSendKeys TextToSend: Empresa1 DelayBetweenKeystrokes: 10 SendTextAsHardwareKeys: False
    MouseAndKeyboard.SendKeys.FocusAndSendKeys TextToSend: Empresa2 DelayBetweenKeystrokes: 10 SendTextAsHardwareKeys: False
    WAIT 1
    MouseAndKeyboard.SendKeys.FocusAndSendKeys TextToSend: $'''{Enter}''' DelayBetweenKeystrokes: 10 SendTextAsHardwareKeys: False
    WAIT (UIAutomation.WaitForImage.ToAppearOnScreen Images: [imgrepo['imgTelaInicial']] FindAllImages: False Tolerance: 10 SearchAlgorithm: UIAutomation.ImageFinderAlgorithm.Legacy X=> X2 Y=> Y2)
    MouseAndKeyboard.SendKeys.FocusAndSendKeys TextToSend: $'''{Control}({F9})''' DelayBetweenKeystrokes: 10 SendTextAsHardwareKeys: False
    WAIT 1
    UIAutomation.PopulateTextField.PopulateTextField TextField: appmask['Window \'TOTVS Série  ...  ( AMBIENTE TESTE ) \''] Text: $'''FIN30043''' Mode: UIAutomation.PopulateTextMode.Replace ClickType: UIAutomation.PopulateMouseClickType.SingleClick
    WAIT 1
    MouseAndKeyboard.SendKeys.FocusAndSendKeys TextToSend: $'''{Enter}''' DelayBetweenKeystrokes: 10 SendTextAsHardwareKeys: False
    WAIT 1
    UIAutomation.Click.Click Element: appmask['Pane \'TotvsSmartClient\''] ClickType: UIAutomation.ClickType.DoubleClick MousePositionRelativeToElement: UIAutomation.RectangleEdgePoint.MiddleCenter OffsetX: 0 OffsetY: 0
    WAIT 2
    MouseAndKeyboard.MoveMouseToImage.MoveMouseToImage Images: [imgrepo['ImageBtnInformar']] SearchForImageOn: MouseAndKeyboard.SearchTarget.EntireScreen MousePositionOnImage: MouseAndKeyboard.PositionOnImage.MiddleCenter OffsetX: 0 OffsetY: 0 Tolerance: 10 MovementStyle: MouseAndKeyboard.MovementStyle.Instant Occurence: 1 Timeout: 5 SearchAlgorithm: MouseAndKeyboard.ImageFinderAlgorithm.Legacy X=> X Y=> Y
    WAIT 1
    MouseAndKeyboard.SendMouseClick.Click ClickType: MouseAndKeyboard.MouseClickType.LeftClick MillisecondsDelay: 0
    WAIT 1
    UIAutomation.PopulateTextField.PopulateTextField TextField: appmask['Window \'TOTVS Série  ...  ( AMBIENTE TESTE ) \''] Text: $'''/logix/unl/%CurrentItem.Name%''' Mode: UIAutomation.PopulateTextMode.Replace ClickType: UIAutomation.PopulateMouseClickType.SingleClick
    WAIT 1
    MouseAndKeyboard.SendKeys.FocusAndSendKeys TextToSend: $'''{F10}''' DelayBetweenKeystrokes: 10 SendTextAsHardwareKeys: False
    WAIT 1
    MouseAndKeyboard.MoveMouseToImage.MoveMouseToImage Images: [imgrepo['ImgBtnProcessar']] SearchForImageOn: MouseAndKeyboard.SearchTarget.EntireScreen MousePositionOnImage: MouseAndKeyboard.PositionOnImage.MiddleCenter OffsetX: 0 OffsetY: 0 Tolerance: 10 MovementStyle: MouseAndKeyboard.MovementStyle.Instant Occurence: 1 Timeout: 5 SearchAlgorithm: MouseAndKeyboard.ImageFinderAlgorithm.Legacy X=> X Y=> Y
    WAIT 1
    MouseAndKeyboard.SendMouseClick.Click ClickType: MouseAndKeyboard.MouseClickType.LeftClick MillisecondsDelay: 0
    WAIT 1
    MouseAndKeyboard.SendKeys.FocusAndSendKeys TextToSend: $'''{Enter}''' DelayBetweenKeystrokes: 10 SendTextAsHardwareKeys: False
    WAIT (UIAutomation.WaitForImage.ToAppearOnScreen Images: [imgrepo['imgMsgEmissaoRelatorio']] FindAllImages: False Tolerance: 10 SearchAlgorithm: UIAutomation.ImageFinderAlgorithm.Legacy X=> X2 Y=> Y2)
    MouseAndKeyboard.MoveMouseToImage.MoveMouseToImage Images: [imgrepo['imgBtnConfirmar']] SearchForImageOn: MouseAndKeyboard.SearchTarget.EntireScreen MousePositionOnImage: MouseAndKeyboard.PositionOnImage.MiddleCenter OffsetX: 0 OffsetY: 0 Tolerance: 10 MovementStyle: MouseAndKeyboard.MovementStyle.Instant Occurence: 1 Timeout: 5 SearchAlgorithm: MouseAndKeyboard.ImageFinderAlgorithm.Legacy X=> X Y=> Y
    WAIT 1
    MouseAndKeyboard.SendMouseClick.Click ClickType: MouseAndKeyboard.MouseClickType.LeftClick MillisecondsDelay: 0
    WAIT 1
    MouseAndKeyboard.SendKeys.FocusAndSendKeys TextToSend: $'''{Enter}''' DelayBetweenKeystrokes: 10 SendTextAsHardwareKeys: False
    WAIT (UIAutomation.WaitForImage.ToAppearOnScreen Images: [imgrepo['ImgRelatorio']] FindAllImages: False Tolerance: 10 SearchAlgorithm: UIAutomation.ImageFinderAlgorithm.Legacy X=> X2 Y=> Y2)
    MouseAndKeyboard.SendKeys.FocusAndSendKeys TextToSend: $'''{Alt}{F4}''' DelayBetweenKeystrokes: 10 SendTextAsHardwareKeys: False
    WAIT (UIAutomation.WaitForImage.ToAppearOnScreen Images: [imgrepo['ImageBtnInformar']] FindAllImages: False Tolerance: 10 SearchAlgorithm: UIAutomation.ImageFinderAlgorithm.Legacy X=> X2 Y=> Y2)
    MouseAndKeyboard.SendKeys.FocusAndSendKeys TextToSend: $'''{F12}''' DelayBetweenKeystrokes: 10 SendTextAsHardwareKeys: False
END
Display.ShowMessageDialog.ShowMessage Title: $'''RPA Importação APDATA X Logix''' Message: $'''Processamento Finalizado.''' Icon: Display.Icon.Information Buttons: Display.Buttons.OK DefaultButton: Display.DefaultButton.Button1 IsTopMost: False ButtonPressed=> ButtonPressed
